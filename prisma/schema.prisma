generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model certificate {
  id            Int                 @id @default(autoincrement())
  company_id    Int
  type          String
  certificate   String
  private_key   String
  public_key    String
  serial_number String?
  expiry_date   DateTime?           @db.Timestamp(6)
  is_active     Boolean?            @default(true)
  created_at    DateTime?           @default(now()) @db.Timestamp(6)
  csid          String?
  secret        String?
  is_deleted    Boolean             @default(false)
  deleted_at    DateTime?           @db.Timestamp(6)
  common_name   String?
  company       company             @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "certificates_company_id_companies_id_fk")
  erp_configs   erp_configuration[]

  @@map("certificates")
}

model company_group {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  companies   company[]

  @@map("company_groups")
}

model company {
  id               Int                 @id @default(autoincrement())
  user_id          String
  vat_number       String              @unique(map: "companies_vat_number_unique")
  cr_number        String
  registered_name  String
  branch_name      String?
  environment      environment?        @default(SANDBOX)
  address          String?
  city             String?
  country          String?             @default("SA")
  created_at       DateTime?           @default(now()) @db.Timestamp(6)
  group_id         Int?
  settings         Json?               @default("{}")
  building_number  String?
  city_subdivision String?
  postal_zone      String?
  street_name      String?
  is_active        Boolean             @default(true)
  is_deleted       Boolean             @default(false)
  deleted_at       DateTime?           @db.Timestamp(6)
  certificates     certificate[]
  branches         branch[]
  group            company_group?      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_group_id_groups_id_fk")
  user             user                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_user_id_users_id_fk")
  customers        customer[]
  erp_configs      erp_configuration[]
  invoices         invoice[]
  items            item[]

  @@map("companies")
}

model branch {
  id               Int       @id @default(autoincrement())
  company_id       Int
  code             String
  name             String
  address          String?
  city             String?
  country          String?   @default("SA")
  postal_zone      String?
  building_number  String?
  street_name      String?
  city_subdivision String?
  is_active        Boolean   @default(true)
  is_deleted       Boolean   @default(false)
  deleted_at       DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)
  settings         Json?     @default("{}")

  company          company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "branches_company_id_companies_id_fk")
  invoices         invoice[]

  @@unique([company_id, code], map: "branches_company_id_code_unique")
  @@index([company_id])
  @@map("branches")
}

model erp_configuration {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     Int
  type           String
  base_url       String
  api_key        String?
  sync_interval  Int          @default(30)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  updated_at     DateTime     @updatedAt @db.Timestamp(6)
  environment    String?
  is_deleted     Boolean      @default(false)
  deleted_at     DateTime?    @db.Timestamp(6)
  certificate_id Int?
  name           String?
  certificate    certificate? @relation(fields: [certificate_id], references: [id], onUpdate: NoAction)
  company        company      @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("erp_configurations")
}

model item {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      Int
  sku             String
  name            String
  description     String?
  unit_price      Decimal  @db.Decimal(12, 2)
  unit_of_measure String   @default("each")
  tax_category    String   @default("S")
  tax_rate        Decimal  @default(0.15) @db.Decimal(5, 2)
  is_deleted      Boolean  @default(false)
  deleted_at      DateTime? @db.Timestamp(6)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)
  company         company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id])
  @@map("items")
}

model customer {
  id         Int       @id @default(autoincrement())
  company_id Int
  name       String
  vat_number String?
  address    String?
  city       String?
  country    String?
  is_deleted Boolean   @default(false)
  deleted_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  company    company   @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_company_id_companies_id_fk")
  invoices   invoice[]

  @@map("customers")
}

model invoice {
  id                    Int             @id @default(autoincrement())
  company_id            Int
  branch_id             Int?
  uuid                  String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number        String
  customer_id           Int?
  date                  DateTime        @db.Timestamp(6)
  total_amount          Decimal         @db.Decimal(12, 2)
  tax_amount            Decimal         @db.Decimal(12, 2)
  status                invoice_status? @default(PENDING)
  type                  invoice_type?   @default(B2B)
  hash                  String?
  zatca_hash            String?
  previous_invoice_hash String?
  xml_payload           String?
  cleared_xml_payload   String?
  qr_code               String?
  submission_id         String?
  submission_response   String?
  created_at            DateTime?       @default(now()) @db.Timestamp(6)
  error_log             String?
  retry_count           Int             @default(0)
  next_attempt_at       DateTime?       @db.Timestamp(6)
  is_deleted            Boolean         @default(false)
  deleted_at            DateTime?       @db.Timestamp(6)
  metadata              Json?
  company               company         @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_company_id_companies_id_fk")
  branch                branch?         @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_branch_id_branches_id_fk")
  customer              customer?       @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_customer_id_customers_id_fk")

  @@unique([company_id, hash])
  @@index([branch_id])
  @@map("invoices")
}

model user {
  id           String    @id
  email        String    @unique(map: "users_email_unique")
  password     String
  name         String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  company_name String?
  role         UserRole  @default(IT_ADMIN)
  companies    company[]

  @@map("users")
}

model audit_log {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp   DateTime @default(now()) @db.Timestamp(6)
  action      String
  category    String
  user        String
  role        String
  ip_address  String
  details     String
  status      String
  resource_id String?
  metadata    Json?    @default("{}")
  payload     String?
  hash        String?

  @@map("audit_logs")
}

model report_template {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String   @default("GENERAL")
  config      Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  @@map("report_templates")
}

enum UserRole {
  IT_ADMIN
  FINANCE_ADMIN
  TAX_OFFICER
  SUPER_ADMIN
}

enum environment {
  SANDBOX
  SIMULATION
  PRODUCTION
}

enum invoice_status {
  PENDING
  PROCESSING
  CLEARED
  REPORTED
  FAILED
  DLQ
}

enum invoice_type {
  B2B
  B2C
  SIMPLIFIED
}
